#include <WiFiNINA.h>
#include <ThingSpeak.h>
#include <DHT.h>
#include <Wire.h>
#include <hp_BH1750.h>

//My internet details
char ssid[] = "Big Brain WiFi";
char password[] = "GiantDonutFire4639";

//ThingSpeak connection details
unsigned long channelID = 3302527;
const char *apiKey = "XS1G072IGU1TMP5J";

//Creating client object
WiFiClient client;

//Sensors setup
#define DHTPIN 2
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);
hp_BH1750 lightsensor;

void connectWiFi();
float readTemperature();
float readLight();
void sendToThingSpeak(float temperature, float light);

//main setup
void setup() {
  Serial.begin(9600);

  dht.begin();                 
  Wire.begin();                
  lightsensor.begin(BH1750_TO_GROUND);

  connectWiFi();
  ThingSpeak.begin(client);
}

//main loop
void loop() {
  float t = readTemperature();
  float l = readLight();

  sendToThingSpeak(t, l);

  delay(30000);
}

//connect Arduino to WiFi
void connectWiFi() {
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(2000);
  }
}

//Read temperature data
float readTemperature() {
  return dht.readTemperature();
}

//Read light level data
float readLight() {
  lightsensor.start();
  return lightsensor.getLux();
}

//Sending values to ThingSpeak
void sendToThingSpeak(float temperature, float light) {
  ThingSpeak.setField(1, temperature);
  ThingSpeak.setField(2, light);
  ThingSpeak.writeFields(channelID, apiKey);
}
