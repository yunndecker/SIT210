#include <WiFiNINA.h>
#include <ThingSpeak.h>
#include <DHT.h>
#include <Wire.h>
#include <hp_BH1750.h>

//WiFi details
char ssid[] = "BigBrainWifi";
char password[] = "Password1";

//ThingSpeak details
unsigned long channelID = 3302527;
const char *apiKey = "YOUR_API_KEY";
//Wifi client object
WiFiClient client;

//Sensors
DHT dht(2, DHT11);
hp_BH1750 light;

//Setup
void setup() {
  dht.begin();
  Wire.begin();
  light.begin(BH1750_TO_GROUND);

  connectWiFi();
  ThingSpeak.begin(client);
}

//Loop
void loop() {
  float t = getTemp();
  float l = getLight();

  sendData(t, l);

  delay(30000);
}

//Connect WiFi
void connectWiFi() {
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(2000);
  }
}

//Get temperature
float getTemp() {
  return dht.readTemperature();
}

//Get light
float getLight() {
  light.start();
  return light.getLux();
}

//Send to ThingSpeak
void sendData(float t, float l) {
  ThingSpeak.setField(1, t);
  ThingSpeak.setField(2, l);
  ThingSpeak.writeFields(channelID, apiKey);
}
