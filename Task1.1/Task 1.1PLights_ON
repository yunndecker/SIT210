# Task 1.1 - Switching on lights. 

const int porch = 2;
const int hallway = 3;
const int button = 4;

void setupPins() {
    pinMode(porch, OUTPUT);
    pinMode(hallway, OUTPUT);
    pinMode(button, INPUT_PULLUP);
}

//Ensuring the lights are off by default
void lights() {
    digitalWrite(porch , LOW);
    digitalWrite(hallway, LOW); 
}

//Turning the lights on
void turnLightsOn() {
    digitalWrite(porch, HIGH);
    digitalWrite(hallway, HIGH);
}

//Turning off porch light
void turnPorchOff() {
    digitalWrite(porch, LOW);
}

//Turning off hallway light
void turnHallwayOff() {
    digitalWrite(hallway, LOW);
}

//Lighting program
void lightProgram() {
    turnLightsOn();

    delay(30000);

    turnPorchOff();

    delay(30000);

    turnHallwayOff();
}

//Check if button is pressed
bool buttonPress() {
    return digitalRead(button) == LOW;
}

//Initial setup
void setup() {
    setupPins();
    lights();
}

//Run the program
void loop() {
    if (buttonPress()) {
        lightProgram();
    }
}

